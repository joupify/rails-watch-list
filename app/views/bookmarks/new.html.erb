<h1>New Bookmark</h1>

<%= simple_form_for [@list, @bookmark] do |f| %>
  <%= f.input :comment, as: :text, input_html: { rows: 4 } %>
  <%= f.association :movie, collection: @movies, label_method: :title, value_method: :id, include_blank: false %>
  <%= f.button :submit, class: "btn btn-primary" %>
<% end %>
