<h1>My List</h1>

<% @lists.each do |list| %>
  <h3><%= list.name %></h3>
  <ul>
    <% list.movies.each do |movie| %>
      <li>
        <h4><%= movie.title %></h4>
        <p><%= movie.overview %></p>
        <%= image_tag "movie.poster_url" %>
      </li>
    <% end %>
  </ul>
  <%= link_to "show", list_path(list) %>
  <%= link_to "Create a movie list", new_list_path, class: "btn btn-success" %>


<% end %>
